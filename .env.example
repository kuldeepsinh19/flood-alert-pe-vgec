# Copy to .env and fill in. .env is gitignored.
#
# The app runs WITHOUT an Anthropic key — it falls back to the 2024 threshold
# rule and says so in the UI. The key is what turns on the AI layer.

# ---- Anthropic (the AI layer) -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model and reasoning effort. Defaults shown.
# Lower effort is cheaper and faster; see docs/ARCHITECTURE.md for the tradeoff.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# ---- Session ------------------------------------------------------------
# Any long random string. Required in production.
SESSION_SECRET=change-me-to-something-random

# ---- Admin access -------------------------------------------------------
# Comma-separated. These accounts can see /admin.
# In the 2024 build this list was hardcoded in index.js in two places.
ADMIN_EMAILS=you@example.com

# ---- Firebase web config -------------------------------------------------
# These are Firebase *web* keys: public by design, gated by Realtime Database
# security rules rather than by secrecy. They were committed directly in
# index.js in 2024; moving them here is about being able to point the app at a
# different Firebase project without editing code, not about hiding them.
# The original project's values are in this repo's git history.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ---- Tuning (all optional) ----------------------------------------------
# How long an AI assessment is reused before a fresh agent run. Default 10 min.
ASSESSMENT_CACHE_TTL_MS=600000

# Open-Meteo rainfall lookup.
WEATHER_TIMEOUT_MS=4000
WEATHER_CACHE_TTL_MS=900000
DISABLE_LIVE_WEATHER=false

# Write a JSON trace per assessment to traces/. Set false to disable.
WRITE_TRACES=true
