    <script>
      /* ------------------------------------------------------------------
       * FloodSense AI — village status and agent assessments.
       *
       * What used to be here, in the 2024 build:
       *
       *     const waterLevel = Math.floor(Math.random() * (221 - 130)) + 130;
       *     updateStatus(waterLevel);
       *     setInterval(... another random number ..., 9000);
       *
       * One random number, re-rolled in the browser every 9 seconds, applied to
       * all seven villages at once — so every village always showed the exact
       * same level and only the thresholds differed.
       *
       * Levels now come from the server (lib/hydrology.js, still simulated but
       * a real per-village hydrograph). Severity comes from the agent pipeline
       * at /api/assess/:village, behind a button because each run costs money
       * and takes a few seconds.
       * ------------------------------------------------------------------ */

      const SEVERITY_CLASS = {
        NORMAL: "status-green",
        WATCH: "status-yellow",
        WARNING: "status-orange",
        EVACUATE: "status-red",
      };
      const SEVERITY_TEXT = {
        NORMAL: "Normal",
        WATCH: "Watch",
        WARNING: "Warning",
        EVACUATE: "Evacuate 🌊🚨",
      };

      const escapeHtml = (s) =>
        String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({
          "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
        })[c]);

      function paintStatus(card, severity, levelCm) {
        card.querySelector('[data-role="circle"]').className =
          "status-circle " + (SEVERITY_CLASS[severity] || "status-green");
        card.querySelector('[data-role="status"]').innerText =
          SEVERITY_TEXT[severity] || severity;
        if (levelCm !== undefined) {
          card.querySelector('[data-role="level"]').innerText = levelCm;
        }
      }

      /* First paint: the deterministic reading the server already rendered.
         No model call, no cost, no waiting. */
      document.querySelectorAll(".village[data-village]").forEach((card) => {
        paintStatus(card, card.dataset.initialSeverity || "NORMAL");
      });

      function renderAssessment(card, data) {
        const a = data.assessment;
        const g = data.guardrail;
        const ad = data.advisory;
        const parts = [];

        parts.push(
          '<div class="ai-row"><span class="ai-severity sev-' + a.severity + '">' +
            a.severity + '</span> <span class="ai-meta">confidence ' +
            Math.round(a.confidence * 100) + '%' +
            (data.mode === "DETERMINISTIC_FALLBACK" ? " &middot; threshold rule only" : "") +
            '</span></div>'
        );

        if (a.hours_to_breach !== null) {
          parts.push(
            '<div class="ai-row"><span class="ai-label">Time to danger level</span><br>' +
              (a.hours_to_breach <= 0
                ? "<strong>already crossed</strong>"
                : "<strong>~" + a.hours_to_breach + " hours</strong>") +
              '</div>'
          );
        }

        parts.push(
          '<div class="ai-row"><span class="ai-label">Predicted peak</span><br>' +
            a.predicted_peak_cm + " cm in " + a.predicted_peak_in_hours + " h</div>"
        );

        parts.push(
          '<div class="ai-row ai-reasoning">' + escapeHtml(a.reasoning) + "</div>"
        );

        if (a.data_quality_concern) {
          parts.push(
            '<div class="ai-row ai-guardrail"><span class="ai-label">Data quality</span><br>' +
              escapeHtml(a.data_quality_concern) + "</div>"
          );
        }

        /* The guardrail is shown, not hidden. If the model tried to talk a real
           flood down, that is the single most important thing on this card. */
        if (g.escalatedByModel) {
          parts.push(
            '<div class="ai-row ai-escalated"><span class="ai-label">Escalated by AI</span><br>' +
              "Threshold rule alone said <strong>" + g.deterministicFloor +
              "</strong>; the agent raised it to <strong>" + g.finalSeverity + "</strong>.</div>"
          );
        }
        (g.interventions || []).forEach((i) => {
          if (i.type === "DOWNGRADE_BLOCKED") {
            parts.push(
              '<div class="ai-row ai-guardrail"><span class="ai-label">Guardrail blocked a downgrade</span><br>' +
                escapeHtml(i.detail) + "</div>"
            );
          }
        });

        if (ad) {
          parts.push(
            '<div class="ai-row"><span class="ai-label">Alert to be sent &middot; ' +
              escapeHtml(ad.audience) + '</span><div class="ai-sms">' +
              escapeHtml(ad.sms_en) + "\n\n" + escapeHtml(ad.sms_gu) + "\n\n" +
              escapeHtml(ad.sms_hi) + "</div></div>"
          );
          if (ad.actions && ad.actions.length) {
            parts.push(
              '<div class="ai-row"><span class="ai-label">Actions</span><ul style="margin:4px 0 0 16px;padding:0;">' +
                ad.actions
                  .map((x) => "<li><strong>" + escapeHtml(x.priority) + "</strong> — " +
                    escapeHtml(x.instruction) + "</li>")
                  .join("") +
                "</ul></div>"
            );
          }
        }

        parts.push(
          '<div class="ai-row ai-meta">' + data.trace.model + " &middot; " +
            (data.trace.totalLatencyMs / 1000).toFixed(1) + "s &middot; $" +
            data.trace.totalCostUsd.toFixed(4) +
            (data.servedFromCache ? " &middot; cached" : "") + "</div>"
        );

        const target = card.querySelector('[data-role="ai-result"]');
        target.innerHTML = parts.join("");
        target.hidden = false;
        paintStatus(card, a.severity, data.reading.levelCm);
      }

      async function assess(card, { refresh = false } = {}) {
        const villageId = card.dataset.village;
        const button = card.querySelector('[data-role="assess"]');
        const target = card.querySelector('[data-role="ai-result"]');

        button.disabled = true;
        button.innerText = "Assessing…";
        try {
          const response = await fetch(
            "/api/assess/" + encodeURIComponent(villageId) + (refresh ? "?refresh=1" : "")
          );
          if (!response.ok) throw new Error("HTTP " + response.status);
          renderAssessment(card, await response.json());
          button.innerText = "Re-run assessment";
        } catch (error) {
          target.innerHTML =
            '<div class="ai-row ai-error">Assessment unavailable: ' +
            escapeHtml(error.message) + "</div>";
          target.hidden = false;
          button.innerText = "Retry";
        } finally {
          button.disabled = false;
        }
      }

      document.querySelectorAll('[data-role="assess"]').forEach((button) => {
        button.addEventListener("click", () =>
          assess(button.closest(".village"), { refresh: button.innerText.startsWith("Re-run") })
        );
      });

      const assessAll = document.getElementById("assessAll");
      if (assessAll) {
        assessAll.addEventListener("click", async () => {
          assessAll.disabled = true;
          assessAll.innerText = "Assessing all villages…";
          /* Sequential: seven concurrent agent runs is a rate-limit risk and
             the user reads them one at a time anyway. */
          for (const card of document.querySelectorAll(".village[data-village]")) {
            await assess(card);
          }
          assessAll.disabled = false;
          assessAll.innerText = "Run AI assessment for all villages";
        });
      }

      // Function to toggle the detailed view of a village
      function toggleDetails(villageId) {
        const detailsDiv = document.getElementById(villageId + "Details");
        detailsDiv.style.display = detailsDiv.style.display === "none" ? "block" : "none";
      }
      function closeDetails(villageId) {
    const detailsDiv = document.getElementById(villageId + "Details");
    detailsDiv.style.display = "none";
  }
      // JavaScript code to handle navigation
      const homeLink = document.getElementById("homeLink");
      const aboutLink = document.getElementById("aboutLink");
      const villagesLink = document.getElementById("villagesLink");

      homeLink.addEventListener("click", () => {
        window.location.href = "/landing"; // Navigate to the home page
      });

      contactLink.addEventListener("click", () => {
        window.location.href = "/contact"; // Navigate to the contact page
      });

      aboutLink.addEventListener("click", () => {
        window.location.href = "/about"; // Navigate to the about page
      });

      villagesLink.addEventListener("click", () => {
        window.location.href = "/villages"; // Navigate to the villages page
      });
    </script>
