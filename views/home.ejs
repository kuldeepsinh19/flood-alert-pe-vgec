    /* General Styles */
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f2f2f2;
      color: #333;
      overflow-x: hidden; /* Hide horizontal scrollbar */
    }
  
    h1 {
      font-family: Arial, sans-serif;
      color: #3498db;
    }
  
    .navbar {
      position: fixed;
      top: 0;
      width: 100%;
      background-color: #3498db;
      padding: 10px;
      color: #fff;
      text-align: center;
      z-index: 1000;
      display: flex;
      align-items: baseline;
    }
  
    .navbar ul {
      list-style-type: none;
      padding: 0;
      margin-left: 36%;
    }
  
    @media only screen and (max-width: 600px) {
      .navbar {
        display: block;
        justify-content: center;
        width: 100%;
      }
  
      .navbar ul {
        margin-left: 0;
      }
    }
  
    .navbar ul li {
      display: inline;
      margin-right: 20px;
    }
  
    .navbar ul li a {
      color: #fff;
      text-decoration: none;
      font-weight: bold;
    }
  
    .container {
      max-width: 100%;
      margin: 70px auto 20px auto;
      padding: 0 20px;
      overflow-y: auto;
      height: calc(100vh - 90px);
      text-align: center;
      box-sizing: border-box;
    }
  
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); /* Adjusted width */
      gap: 30px;
    }
  
    .village {
      background-color: #63adde;
      border: 1px solid #fcfafa;
      border-radius: 7px;
      padding: 20px;
      text-align: center;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); /* Added light shadow */
    }
  
    .status-circle {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: inline-block;
    }
  
    .text {
      color: #fff;
      font-family: Arial, Helvetica, sans-serif;
      font-weight: 800;
    }
  
    .status-red {
      background-color: red;
    }
  
    h2 {
      color: #fff;
      font-family: Arial, Helvetica, sans-serif;
      font-weight: 800;
    }
  
    .status-orange {
      background-color: orange;
    }
  
    .status-green {
      background-color: green;
    }
  
    .footer {
      background-color: #3498db;
      color: #fff;
      text-align: center;
      padding: 20px 0;
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
    }
  
    .detailed-view {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5); /* Semi-transparent background */
      z-index: 1000; /* Ensure it's above other content */
      overflow-y: auto; /* Allow scrolling if content overflows */
    }
  
    .detailed-view .container {
      max-width: 800px;
      margin: 100px auto; /* Center the detailed view */
      background-color: #fff;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.3); /* Add shadow */
    }
  
    /* Button Styles */
    .detailed-view button {
      background-color: #3498db;
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: 5px;
      cursor: pointer;
      margin-top: 20px;
      transition: background-color 0.3s;
    }
  
    .detailed-view button:hover {
      background-color: #2980b9;
    }
  
    /* Close button */
    .detailed-view button.close-button {
      position: absolute;
      top: 10px;
      right: 10px;
      background-color: transparent;
      color: #333;
      font-size: 16px;
      padding: 5px;
      border: none;
      cursor: pointer;
    }
  /* CSS for the toggle button */
button {
    background-color: #3498db;
    color: #fff;
    border: none;
    padding: 10px 20px;
    font-size: 1rem;
    cursor: pointer;
    border-radius: 5px;
}

button:hover {
    background-color: #2980b9;
}

    .detailed-view button.close-button:hover {
      color: #666;
    }
    /* ---- FloodSense AI panel ---------------------------------------- */
    .status-yellow { background-color: #e6c200; }

    .ai-panel {
      margin: 14px 0 10px;
      padding: 10px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.92);
      text-align: left;
      color: #21313c;
      font-size: 13px;
      line-height: 1.45;
    }
    .ai-button {
      width: 100%;
      padding: 8px 10px;
      border: none;
      border-radius: 6px;
      background: #14507d;
      color: #fff;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
    }
    .ai-button:hover { background: #0e3a5c; }
    .ai-button[disabled] { background: #7d93a3; cursor: progress; }
    .ai-severity {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 999px;
      font-weight: 800;
      font-size: 12px;
      letter-spacing: 0.04em;
      color: #fff;
    }
    .sev-NORMAL   { background: #1c7c3c; }
    .sev-WATCH    { background: #9a7d00; }
    .sev-WARNING  { background: #c2620a; }
    .sev-EVACUATE { background: #b3141c; }
    .ai-row { margin: 7px 0; }
    .ai-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: #5a6b78;
      font-weight: 700;
    }
    .ai-reasoning { font-style: italic; }
    .ai-sms {
      background: #10202b;
      color: #cfe8d0;
      padding: 8px 10px;
      border-radius: 6px;
      font-family: ui-monospace, Menlo, Consolas, monospace;
      font-size: 12px;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .ai-guardrail {
      border-left: 3px solid #b3141c;
      padding-left: 8px;
      background: #fdf0f0;
      font-size: 12px;
    }
    .ai-escalated {
      border-left: 3px solid #c2620a;
      padding-left: 8px;
      background: #fff6ec;
      font-size: 12px;
    }
    .ai-meta { font-size: 11px; color: #6b7c88; }
    .ai-error { color: #b3141c; font-weight: 600; }
    .sim-banner {
      max-width: 900px;
      margin: 0 auto 18px;
      padding: 10px 14px;
      border-radius: 8px;
      background: #fff8e1;
      border: 1px solid #e0c56b;
